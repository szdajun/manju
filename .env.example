# manju TTS 凭证 — 复制为 .env 填值 (.env 被 .gitignore 挡, 不入 git)
# MiniMax T2A 账号级 key: coding(abab/M1) 与 TTS(T2A) 共用同一把

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 可选调参 (留空走默认)
MINIMAX_MODEL=speech-02-hd            # speech-02-hd(默认) / speech-01-turbo(便宜快)
MINIMAX_VOICE=male-qn-qingse          # 青涩青年男声; 备选 male-qn-jingying / Boyan_new
MANJU_TTS=minimax                     # edge | volcano | minimax
